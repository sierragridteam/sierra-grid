---
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/ibm-plex-sans/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@sierragridteam/design-system/styles/global.css';
import IconSprite from '@sierragridteam/design-system/components/IconSprite.astro';
interface Props { title: string; description?: string; }
const { title, description = 'Explore SIERRA observations, mesh telemetry and changes over time.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · S.I.E.R.R.A Grid</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <IconSprite />
    <slot />
    <div id="toasts" class="toasts" aria-live="polite"></div>
  </body>
</html>
